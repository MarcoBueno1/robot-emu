<library path="robot_emulator_ros2">
  <class name="robot_emulator_ros2/RobotEmulatorHardwareInterface"
         type="robot_emulator_ros2::RobotEmulatorHardwareInterface"
         base_class_type="hardware_interface::SystemInterface">
    <description>
      Connects to a running apps/robot-emulator over the binary TCP protocol
      (docs/architecture.md section 3.7) via robot::cli::Client, exposing its
      joints as standard ros2_control position/velocity state interfaces and
      a position command interface.
    </description>
  </class>
</library>
