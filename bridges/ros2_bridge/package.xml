<package format="3">
  <name>robot_emulator_ros2</name>
  <version>0.1.0</version>
  <description>
    ros2_control SystemInterface plugin for the Robot Emulator Framework —
    connects to a running apps/robot-emulator over its binary TCP protocol,
    reusing robot::cli::Client exactly as robotctl does. See
    docs/architecture.md section 3.16.
  </description>
  <maintainer email="bueno.marco@gmail.com">Marco Bueno</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
